menuconfig FMD_SNOR
    tristate "spi nor flash support"
    depends on FMD
    help
        This is the hardware abastraction layer for the spi nor flash.

if FMD_SNOR
config FLASH_XIP
    tristate "FLASH XIP support"
    depends on FMD_SNOR
    help
        This enables support for FLASH XIP.
endif
