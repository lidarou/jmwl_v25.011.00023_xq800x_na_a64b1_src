menuconfig PWM
    bool "PWM Drivers"
    depends on SUBSYS_AP
    help
      Enable config options for PWM drivers.

if PWM

config PWM_DRIVER
    bool "Driver PWM module"
    default n
    help
      Select PWM module.

config PWM_AT
    bool "PWM at command support."
    depends on PWM_DRIVER
    default n
    help
      Select PWM module.

endif