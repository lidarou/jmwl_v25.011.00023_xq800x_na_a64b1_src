menuconfig PMIC_I2C
    bool "PMIC_I2C Drivers"
    help
      Enable config options for PMIC I2C drivers.

if PMIC_I2C

config PMIC_I2C_DRIVER
    bool "Driver PMIC I2C module"
    default n
    help
      Select PMIC I2C module.

config PMIC_I2C_TEST
    bool "PMIC I2C module test"
    depends on PMIC_I2C
    default n
    help
      Select PMIC I2C module test.

config PMIC_I2C_GP201
    bool "PMIC I2C GP201 test"
    depends on PMIC_I2C
    default n
    help
      Select PMIC I2C GP201 test.

endif
