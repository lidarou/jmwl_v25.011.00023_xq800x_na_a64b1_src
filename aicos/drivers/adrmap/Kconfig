menuconfig ADRMAP
    bool "ADRMAP Drivers"
    depends on SUBSYS_CP
    help
      Enable config options for adrmap drivers.

if ADRMAP

config ADRMAP_DRIVER
    bool "ADRMAP module driver"
    default n
    help
      adrmap module driver.

endif # ADRMAP