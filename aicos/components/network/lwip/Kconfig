menu "Lwip Configurations"

config TCPIP_LWIP
    bool "support tcpip lwip library"
    depends on USE_LWIP
    default n

menu "Lwip Socket test Configurations"
config TCPIP_LWIP_TEST
    bool "support tcpip lwip test"
    depends on TCPIP_LWIP
    default n

