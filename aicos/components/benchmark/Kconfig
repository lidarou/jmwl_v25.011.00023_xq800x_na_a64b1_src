menu "Benchmark Configurations"

config BENCHMARK
    bool "Run benchmark"
    default y

config BCMARK_DHRYSTONE 
    bool "Run dhrystone v2.1"
    depends on BENCHMARK
    help
      Run dhrystone for evaluation

endmenu # Benchmark Configurations
