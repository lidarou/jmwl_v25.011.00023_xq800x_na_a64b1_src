menu "APP Component & Utility"

config COMP_STATUSBAR
    bool "Enable Component Statusbar"
    depends on APP_ENTRY_IDLE
    default n
    help
        Enable Component of Statusbar

config COMP_SOFTKEY
    bool "Enable Component SoftKey"
    depends on APP_ENTRY_IDLE
    default n
    help
        Enable Component of SoftKey

config COMP_CAMERA_PREVIEW
    bool "Enable Component Camera Preview"
    depends on APP_ENTRY_IDLE
    default n
    help
        Enable Component of Camera Preview

config COMP_MSGBOX
    bool "Enable Component Msgbox"
    #depends on APP_ENTRY_IDLE
    default n
    help
        Enable Component Msgbox

config USE_ALV_BTNMATRIX
    bool "Use alv_btnmatrix widget"
    depends on LV_USE_BTNMATRIX
    default n
    help
      A customized widget which inherits from lv_btnmatrix.

config USE_ALV_MENU
    bool "Use alv menu widget"
    depends on LV_USE_LIST
    default n
    help
      A customized menu widget which is based on lv_list.

config USE_APP_FS
    bool "Use APP FS"
    depends on FS && LV_CONF_MINIMAL
    default n
    help
      Enable common APIs to operate on FS and monitoring device mount

config USE_SQUARELINE_COMMON_CODE
    bool "Use Squareline Studio auto-generated code"
    depends on LV_CONF_MINIMAL
    default n
    help
      Enable to use common ui helper&component auto-generated by squareline.

endmenu #menu "APP Component & Utility"

endif #if APP

