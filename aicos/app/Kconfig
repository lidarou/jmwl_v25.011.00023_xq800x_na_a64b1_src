menuconfig APP
    bool "Application Options"
    default n

if APP

choice
    bool "Choice First entry APP"
    depends on APP
    default APP_ENTRY_EM
    help
        select which APP should be run.

    config APP_ENTRY_NOGUI
        bool "Application entry point without GUI"
        help
            Application entry point without GUI

    config APP_ENTRY_IDLE
        bool "Idle"
        select APP_IDLE
        select USE_SQUARELINE_COMMON_CODE
        depends on LV_CONF_MINIMAL
        depends on ALV_APP_MGR
        help
          Depends on LV_CONF_MINIMAL at "(Top) → Components Options → Graphics Options → LVGL configuration"
          Depends on ALV_APP_MGR at "(Top) → Components Options → Graphics Options"

    config APP_ENTRY_IDLE_FP
        bool "Idle for FP"
        select APP_IDLE_FP
        select USE_SQUARELINE_COMMON_CODE
        depends on LV_CONF_MINIMAL
        depends on ALV_APP_MGR
        help
          Depends on LV_CONF_MINIMAL at "(Top) → Components Options → Graphics Options → LVGL configuration"
          Depends on ALV_APP_MGR at "(Top) → Components Options → Graphics Options"

    config APP_ENTRY_EM
        bool "Engineering Mode"
        select APP_EM
        depends on LV_CONF_MINIMAL
        depends on ALV_APP_MGR
        help
          Depends on LV_CONF_MINIMAL at "(Top) → Components Options → Graphics Options → LVGL configuration"
          Depends on ALV_APP_MGR at "(Top) → Components Options → Graphics Options"

    config APP_ENTRY_LVGL_DEMO
        bool "LGVL Demo"
        depends on LV_CONF_MINIMAL
        help
          Depends on LV_CONF_MINIMAL at "(Top) → Components Options → Graphics Options → LVGL configuration"

        if APP_ENTRY_LVGL_DEMO
        source "app/lvgl_demo_apps/Kconfig"
        endif # APP_ENTRY_LVGL_DEMO
endchoice

config FP
    bool "Feature Phone"
    default n
    help
        Feature Phone

config SUPPORT_PHYSICAL_KEY
    bool "Support Physical key"
    default n
    help
        Support Physical key


choice
    bool "Choice Resolution Ratio"
    depends on LV_CONF_MINIMAL
    default RESOLUTION_240x320
    help
      select resolution which graphics should be select.

    config RESOLUTION_240x320
        bool "240x320"
        help
          select resolution ratio 240x320

    config RESOLUTION_128x128
        bool "128x128"
        help
          select resolution ratio 128x128
endchoice #choice "Resolution Ratio"


menu "Config boot & charge animation"

    config BOOT_ANIMATION
        bool "Enable boot animation"
        default n
        help
            Enable Boot animaiton

    config CHARGE_ANIMATION
        bool "Enable charge animation when system shutdown(If disable Show picture only)"
        default n
        help
            Enable Charge animaiton

endmenu # menu "Config boot & charge animation"


