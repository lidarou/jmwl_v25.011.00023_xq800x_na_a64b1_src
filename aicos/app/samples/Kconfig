menu "Sample codes"
    depends on APP

    config I2C_SAMPLE
        bool "I2C sample"
        help
           Select i2c sample.

    config UART_SAMPLE
        bool "UART sample"
        help
           Select uart sample.

    config POWER_SUPPLY_SAMPLE
        bool "power supply sample"
        select POWER_SUPPLY
        select POWER_SUPPLY_CORE
        help
           Select power supply sample.

    config BACKLIGHT_SAMPLE
        bool "backlight operate sample code"
        depends on DRIVER_BACKLIGHT
        default n
        help
            lcd panel backlight user demo.

    config SMS_SAMPLE
        bool "sms sample"
        default n
        help
           Select sms sample.

    config RADIO_CFUN_SAMPLE
        bool "radio cfun sample"
        default n
        help
           Select radio cfun sample.

    config WIFISCAN_SAMPLE
        bool "wifi scan sample"
        help
           Select wifi scan sample.

    config APP_AUDIO_MP3_SAMPLE
        bool "app audio mp3 sample"
        help
           Select app audio mp3 sample.

    config WAKEUP_SAMPLE
        bool "wakeup sample"
        default n
        help
           Select wakeup sample.

    config SSP_SAMPLE
        bool "ssp sample"
        default n
        help
           Select ssp sample.

    config AUTO_REG_IMS_SAMPLE
        bool "auto reg ims sample"
        default n
        help
           Select auto reg ims sample.

